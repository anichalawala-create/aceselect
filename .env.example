# Supabase is required for production admin authentication, uploads, and cloud persistence.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Optional local development credentials for the admin login flow.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
